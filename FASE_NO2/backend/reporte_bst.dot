digraph ArbolPeliculas {
    rankdir=TB;
    ordering=out;
    graph [bgcolor="white", labelloc="t", fontsize=18, fontname="Arial", label="Arbol binario de busqueda (Cartelera de Peliculas)\nEstado BST: CORRECTO | Total de peliculas: 3"];
    graph [nodesep=0.55, ranksep=0.80];
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#37474f", penwidth=1.4, margin="0.10,0.08"];
    edge [color="#37474f", arrowsize=0.8, fontname="Arial", fontsize=9, weight=2];
    subgraph cluster_leyenda {
        label="Leyenda";
        color="#cfd8dc";
        style="rounded";
        leyenda_verde [label="Verde: en cartelera", fillcolor="#b7e1a1"];
        leyenda_amarillo [label="Amarillo: proximo a retirar (menos de una semana)", fillcolor="#ffe082"];
        leyenda_gris [label="Gris: fecha fin vencida", fillcolor="#e0e0e0"];
        { rank=same; leyenda_verde; leyenda_amarillo; leyenda_gris; }
    }
    nodo901 [fillcolor="#b7e1a1", label="Codigo: WEB901\nTitulo: Dune: Parte Dos\nDuracion: 166 min\nClasificacion: B15\nFecha fin: 2026-12-31\nEstado: En cartelera (66 dias)"];
    nodo901 -> nodo123 [label="izq"];
    nodo901 -> nodo902 [label="der"];
    { rank=same; nodo123; nodo902; }
    nodo123 -> nodo902 [style=invis, weight=20];
    nodo123 [fillcolor="#b7e1a1", label="Codigo: WEB903\nTitulo: Cars 4\nDuracion: 120 min\nClasificacion: AA\nFecha fin: 2026-12-31\nEstado: En cartelera (66 dias)"];
    nodo902 [fillcolor="#b7e1a1", label="Codigo: WEB902\nTitulo: Intensamente 2\nDuracion: 100 min\nClasificacion: AA\nFecha fin: 2026-11-30\nEstado: En cartelera (35 dias)"];
}
