digraph ArbolPeliculas {
    rankdir=TB;
    graph [bgcolor="white", labelloc="t", label="Arbol binario de busqueda (Cartelera de Peliculas)"];
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#37474f", penwidth=1.4];
    edge [color="#37474f", arrowsize=0.8];
    leyenda_verde [label="En cartelera", fillcolor="#b7e1a1"];
    leyenda_amarillo [label="Proximo a retirar (< 7 dias)", fillcolor="#ffe082"];
    { rank=same; leyenda_verde; leyenda_amarillo; }
    nodo50 [fillcolor="#b7e1a1", label="Codigo: CO-50\nTitulo: Inception\nDuracion: 148 min\nClasificacion: PG-13\nFecha fin: 24/08/2026"];
    nodo50 -> nodo25;
    nodo25 [fillcolor="#b7e1a1", label="Codigo: CO-25\nTitulo: Interstellar\nDuracion: 169 min\nClasificacion: PG-13\nFecha fin: 30/09/2026"];
    nodo25 -> nodo10;
    nodo10 [fillcolor="#ffe082", label="Codigo: CO-10\nTitulo: Matrix\nDuracion: 136 min\nClasificacion: R\nFecha fin: 20/08/2026"];
    nodo50 -> nodo75;
    nodo75 [fillcolor="#b7e1a1", label="Codigo: CO-75\nTitulo: Dune\nDuracion: 155 min\nClasificacion: PG-13\nFecha fin: 15/10/2026"];
}
