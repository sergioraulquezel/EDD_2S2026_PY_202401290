digraph ArbolPeliculas {
    rankdir=TB;
    graph [bgcolor="white", labelloc="t", label="Arbol binario de busqueda (Cartelera de Peliculas)"];
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#37474f", penwidth=1.4];
    edge [color="#37474f", arrowsize=0.8];
    leyenda_verde [label="En cartelera", fillcolor="#b7e1a1"];
    leyenda_amarillo [label="Proximo a retirar (< 7 dias)", fillcolor="#ffe082"];
    { rank=same; leyenda_verde; leyenda_amarillo; }
    nodo1 [fillcolor="#b7e1a1", label="Codigo: P001\nTitulo: Avatar 3\nDuracion: 180 min\nClasificacion: B15\nFecha fin: 2026-03-15"];
    nodo1 -> nodo2;
    nodo2 [fillcolor="#ffe082", label="Codigo: P002\nTitulo: Intensamente 2\nDuracion: 100 min\nClasificacion: AA\nFecha fin: 2026-08-20"];
}
