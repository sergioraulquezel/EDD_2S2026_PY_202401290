digraph Promociones {
  graph [rankdir=TB, splines=true, nodesep=0.75, ranksep=0.65, bgcolor="white", labelloc="t", label="Reporte 3: Lista Circular de Listas (Promociones y Beneficios)"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.08,0.06"];
  edge [fontname="Arial", fontsize=9, color="#37474f", arrowsize=0.8];
  { rank=same; promo_1; promo_2; promo_3; promo_4; promo_5; }
  promo_1 [label="Codigo: 1\nLunes Estudiantil\nDescuentos con carnet universitario", fillcolor="#dceff1", color="#37474f", penwidth=1.5];
  promo_1 -> promo_2 [constraint=false];
  ben_1_0 [label="Descuento en boleto\n50%", fillcolor="#fff9c4", color="#9e9d24"];
  promo_1 -> ben_1_0 [dir=both, color="#546e7a"];
  ben_1_1 [label="Descuento en pipocas grandes\n20%", fillcolor="#fff9c4", color="#9e9d24"];
  ben_1_0 -> ben_1_1 [dir=both, color="#546e7a"];
  null_1 [label="null", width=0.45, height=0.2, fontsize=8, fillcolor="#fff9c4", color="#9e9d24"];
  ben_1_1 -> null_1 [style=dashed, color="#546e7a"];
  promo_2 [label="Codigo: 2\nMiercoles 2x1\nLleva a un acompaniante gratis", fillcolor="#dceff1", color="#37474f", penwidth=1.5];
  promo_2 -> promo_3 [constraint=false];
  ben_2_0 [label="Boleto extra gratis\n100%", fillcolor="#fff9c4", color="#9e9d24"];
  promo_2 -> ben_2_0 [dir=both, color="#546e7a"];
  null_2 [label="null", width=0.45, height=0.2, fontsize=8, fillcolor="#fff9c4", color="#9e9d24"];
  ben_2_0 -> null_2 [style=dashed, color="#546e7a"];
  promo_3 [label="Codigo: 3\nCalificacin 1\nc1", fillcolor="#dceff1", color="#37474f", penwidth=1.5];
  promo_3 -> promo_4 [constraint=false];
  ben_3_0 [label="papas medianas\n10%", fillcolor="#fff9c4", color="#9e9d24"];
  promo_3 -> ben_3_0 [dir=both, color="#546e7a"];
  ben_3_1 [label="2X1\n10%", fillcolor="#fff9c4", color="#9e9d24"];
  ben_3_0 -> ben_3_1 [dir=both, color="#546e7a"];
  ben_3_2 [label="Descuento del 50% en bebidas\n10%", fillcolor="#fff9c4", color="#9e9d24"];
  ben_3_1 -> ben_3_2 [dir=both, color="#546e7a"];
  ben_3_3 [label="Papas grandes\n10%", fillcolor="#fff9c4", color="#9e9d24"];
  ben_3_2 -> ben_3_3 [dir=both, color="#546e7a"];
  ben_3_4 [label="Regalos en sorteo especial\n10%", fillcolor="#fff9c4", color="#9e9d24"];
  ben_3_3 -> ben_3_4 [dir=both, color="#546e7a"];
  ben_3_5 [label="2x1\n10%", fillcolor="#fff9c4", color="#9e9d24"];
  ben_3_4 -> ben_3_5 [dir=both, color="#546e7a"];
  ben_3_6 [label="Papas grandes gratis por la compra de una\n10%", fillcolor="#fff9c4", color="#9e9d24"];
  ben_3_5 -> ben_3_6 [dir=both, color="#546e7a"];
  null_3 [label="null", width=0.45, height=0.2, fontsize=8, fillcolor="#fff9c4", color="#9e9d24"];
  ben_3_6 -> null_3 [style=dashed, color="#546e7a"];
  promo_4 [label="Codigo: 4\nCalificacin 2\nc1", fillcolor="#dceff1", color="#37474f", penwidth=1.5];
  promo_4 -> promo_5 [constraint=false];
  null_4 [label="null", width=0.45, height=0.2, fontsize=8, fillcolor="#fff9c4", color="#9e9d24"];
  promo_4 -> null_4 [style=dashed, color="#546e7a"];
  promo_5 [label="Codigo: 5\nCalificacin 3\nc1", fillcolor="#dceff1", color="#37474f", penwidth=1.5];
  promo_5 -> promo_1 [constraint=false, minlen=2, label="circular"];
  null_5 [label="null", width=0.45, height=0.2, fontsize=8, fillcolor="#fff9c4", color="#9e9d24"];
  promo_5 -> null_5 [style=dashed, color="#546e7a"];
}
